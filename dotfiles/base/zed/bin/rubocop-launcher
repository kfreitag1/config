#!/bin/sh
# Zed RuboCop LSP launcher.
#
# RuboCop ships a native language server (`rubocop --lsp`) providing formatting,
# lint diagnostics, and autocorrect code-actions. We route it through the zone's
# shadowenv + bundle so it loads the project's .rubocop.yml, custom cops, and
# plugins (rubocop-sorbet, rubocop-rails, ...) with the correct Ruby.
#
# Resolution:
#   1. Nearest Gemfile.lock upward pins rubocop -> shadowenv exec -- bundle exec
#      rubocop --lsp (zone-aware, loads the project's full RuboCop config).
#   2. Otherwise -> global `rubocop --lsp` on PATH.
#
# If rubocop can't start, Zed reports it once and Sorbet keeps running.
# Invoked by Zed via lsp.rubocop.binary.path in settings.json.

set -eu

TEC_BIN="/Users/kieran/.local/state/tec/profiles/base/current/global/bin"
SHADOWENV="$TEC_BIN/shadowenv"
export PATH="$TEC_BIN:$PATH"

# Nearest ancestor (or self) containing a Gemfile. Stops at $HOME.
find_gemfile_dir() {
  dir=$PWD
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    [ -f "$dir/Gemfile" ] && { printf '%s\n' "$dir"; return 0; }
    [ "$dir" = "$HOME" ] && break
    parent=$(dirname "$dir")
    [ "$parent" = "$dir" ] && break
    dir=$parent
  done
  return 1
}

in_env() {
  if [ -x "$SHADOWENV" ]; then
    "$SHADOWENV" exec -- "$@"
  else
    "$@"
  fi
}

bundle_ok() {
  for spec in .dev/gem/specifications/*.gemspec; do
    name=${spec##*/}
    [ -e ".dev/gem/gems/${name%.gemspec}" ] || return 1
  done
  [ -z "$(find -L .dev/gem/bundler/gems -maxdepth 1 -type l -print -quit 2>/dev/null)" ] || return 1
  in_env bundle check >/dev/null 2>&1
}

# Lockfile pulls and tec env rebuilds leave .dev/gem stale; stdout is the LSP channel so all output goes to stderr
heal_bundle() {
  if [ ! -d .shadowenv.d ]; then
    case $PWD in "$HOME"/world/*) echo "zed: no zone env in $PWD, run dev up there" >&2; exit 1 ;; esac
    return 0
  fi
  lock=".dev/zed-bundle.lock"
  mkdir -p .dev
  waited=0
  until mkdir "$lock" 2>/dev/null; do
    waited=$((waited + 1))
    [ "$waited" -ge 300 ] && { rmdir "$lock" 2>/dev/null || true; }
    sleep 1
  done
  bundle_ok || in_env bundle install --quiet >&2 || true
  rmdir "$lock"
}

if gemfile_dir=$(find_gemfile_dir) && \
   [ -f "$gemfile_dir/Gemfile.lock" ] && \
   grep -qE '^[[:space:]]+rubocop[[:space:]]+\(' "$gemfile_dir/Gemfile.lock"; then
  cd "$gemfile_dir"
  heal_bundle
  if [ -x "$SHADOWENV" ]; then
    exec "$SHADOWENV" exec -- bundle exec rubocop --lsp "$@"
  fi
  exec bundle exec rubocop --lsp "$@"
fi

exec rubocop --lsp "$@"
