include "/etc/niri/default-config.kdl"

prefer-no-csd

input {
    disable-power-key-handling

    keyboard {
        repeat-delay 150
        repeat-rate 33
    }
    touchpad {
        dwt
        scroll-factor 0.15
    }
}

layout {
    focus-ring {
        width 3
        active-color "B9D0AA"
    }
    shadow {
        on
        draw-behind-window true
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

binds {
    Mod+T { spawn "ghostty"; }
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }

    Mod+D { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+N { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+X { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Shift+Comma { spawn "noctalia" "msg" "settings-toggle"; }
    XF86PowerOff { spawn "hyprlock"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
}

hotkey-overlay {
    skip-at-startup
}
